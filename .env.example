# Local API settings. Copy to .env and replace placeholders; never commit .env.
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CORS_ALLOWED_ORIGINS=http://localhost:5000

# Paid AI is fail-closed. Keep this false and leave the key empty for no-spend use.
AI_REQUESTS_ENABLED=false
OPENAI_API_KEY=

# Legacy Replit sign-in remains available until the Google-auth migration lands.
ISSUER_URL=https://replit.com/oidc
REPL_ID=your-replit-app-id
