# Local API settings. Copy to .env and replace placeholders; never commit .env.
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CORS_ALLOWED_ORIGINS=http://localhost:5000

# Paid AI is fail-closed. Keep this false and leave the key empty for no-spend use.
AI_REQUESTS_ENABLED=false
OPENAI_API_KEY=

# Google browser sign-in (recommended for the free-hosting deployment).
AUTH_PROVIDER=google
APP_ORIGIN=https://your-alphadesk-service.example
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Legacy Replit mode only. Comment out the Google variables above, then use:
# AUTH_PROVIDER=replit
# ISSUER_URL=https://replit.com/oidc
# REPL_ID=your-replit-app-id
