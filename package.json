{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts/enforce-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm --filter @workspace/portfolio-intelligence run build && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/mockup-sandbox run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:research": "tsx --test lib/research-contracts/src/**/*.test.ts artifacts/api-server/src/services/research/**/*.test.ts artifacts/api-server/src/routes/researchAutomation.test.ts artifacts/api-server/src/services/portfolio/portfolioResearchTrigger.integration.test.ts artifacts/api-server/src/services/intelligence/marketResearchTrigger.test.ts artifacts/portfolio-intelligence/src/features/research/**/*.test.ts",
    "test:db": "tsx --test lib/db/src/**/*.test.ts"
  },
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3"
  }
}
